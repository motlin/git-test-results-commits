# Ignore everything by default
**/*
# Re-include directories so oxfmt descends into them when given a directory like `.`
!**/

# Only format these file types
!**/*.yml
!**/*.yaml
!**/*.md
!**/*.html
!**/*.css
!**/*.json
!**/*.jsonc

# But still ignore these directories
node_modules
dist
build
.llm
target
.github/workflows
